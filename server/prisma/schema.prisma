// Prisma schema = (1) how to generate the TS client, (2) which DB engine, (3) your tables as `model`s.
// Connection URL lives in prisma.config.ts → process.env.DATABASE_URL (your .env).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  picture      String?
  createdAt    DateTime   @default(now())
  trips        TripPlan[]
}

/// One row = one generated trip (destination, dates, full plan JSON, optional weather JSON).
model TripPlan {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  destination String
  days        Int?
  travelers   Int?
  type        String?
  startDate   String
  endDate     String
  plan        Json
  weather     Json?
  shareId     String   @unique @default(cuid())
  isPublic    Boolean  @default(true)
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id])
  updatedAt   DateTime @updatedAt
}

model HotelCache {
  id               String   @id @default(cuid())
  hotelName        String   // The name AI gave us
  city             String   // The destination city
  
  // Google Data
  rating           Float?
  userRatingsTotal Int?
  address          String?
  mapUrl           String?
  photoReference   String?
  lat              Float?
  lng              Float?

  // Housekeeping
  updatedAt        DateTime @updatedAt

  // The "Brain" of the cache: 
  // This ensures we never store the same hotel in the same city twice.
  @@unique([hotelName, city])
}

